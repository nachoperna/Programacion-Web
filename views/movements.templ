package views 

import (
	sqlc "TP_Especial/db/sqlc"
	"fmt"
)

templ GetMovements(movimientos []sqlc.GetHistoryRow, alias string, offset int, siguiente bool) {
	if (len(movimientos) == 0) {
		<h3>No tienes movimientos realizados por el momento...</h3>
	} else {
		<table id="tabla-pedidos">
			<thead>
				<tr>
					<th>Tipo</th>
					<th>Monto</th>
					<th>Dia</th>
					<th>Hora</th>
				</tr>
			</thead>
			<tbody>
				for _, mov := range movimientos {
					<tr>
						<td>{ mov.Type }</td>
						<td>$ { mov.Amount }</td>
						<td>{ mov.Day }</td>
						<td>{ mov.Time }</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="botones-pagina">
			if (offset > 0) {
				<a
					type="button"
					class="boton-anterior"
					hx-get={ fmt.Sprintf("/listMovements?alias=%s&order=anterior&offset=%d", alias, offset) }
					hx-target="#tabla-pedidos-container"
					hx-swap="innerHTML"
				>Anterior</a>
			}
			if (siguiente) {
				<a
					type="button"
					class="boton-siguiente"
					hx-get={ fmt.Sprintf("/listMovements?alias=%s&order=siguiente&offset=%d", alias, offset) }
					hx-target="#tabla-pedidos-container"
					hx-swap="innerHTML"
				>Siguiente</a>
			}
		</div>
	}
}
